# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional built-in administrator account. Set both values or leave both blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: where the app reads the client IP for rate limiting.
#   none (default)   - no client IP; each endpoint gets one shared limit instead
#                      of one per address. Safe when no trusted edge/proxy sits
#                      in front, because clients can set the headers below.
#   cf               - the CF-Connecting-IP header. Only when Cloudflare is
#                      actually in front and its edge overwrites the header.
#   x-forwarded-for  - the last X-Forwarded-For hop, the one added by the single
#                      trusted reverse proxy you run in front.
#TRUSTED_IP_SOURCE=

# Optional: the address people open, for example https://hrt.example.com.
# Share links use it, and passkeys accept it when your proxy does not pass
# the browser's Host header through.
#PUBLIC_APP_ORIGIN=
