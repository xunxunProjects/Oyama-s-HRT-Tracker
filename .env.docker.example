# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional built-in administrator account. Set both values or leave both blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: where the app reads the client IP for rate limiting.
#   cf (default)     - Cloudflare's CF-Connecting-IP header
#   x-forwarded-for  - first X-Forwarded-For hop; only with a proxy you control
#   none             - no client IP (Tor/I2P mirror); per-IP limits are skipped
#TRUSTED_IP_SOURCE=
