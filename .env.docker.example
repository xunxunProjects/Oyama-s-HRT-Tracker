# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional built-in administrator account. Set both values or leave both blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: where the app reads the client IP for rate limiting.
#   cf (default)     - the CF-Connecting-IP header. Without Cloudflare in front,
#                      have your proxy overwrite it with the client address,
#                      or a client can send its own
#   x-forwarded-for  - the last X-Forwarded-For hop, the one added by the single
#                      reverse proxy you run in front
#   none             - no client IP (Tor/I2P mirror); each endpoint gets one
#                      shared limit instead of one per address
#TRUSTED_IP_SOURCE=

# Optional: the address people open, for example https://hrt.example.com.
# Share links use it, and passkeys accept it when your proxy does not pass
# the browser's Host header through.
#PUBLIC_APP_ORIGIN=
