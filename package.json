{
  "name": "oyama-s-hrt-tracker",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "wrangler:dev": "npm run build && wrangler dev",
    "wrangler:migrate:local": "wrangler d1 migrations apply hrt-tracker-prod --local",
    "wrangler:migrate:remote": "wrangler d1 migrations apply hrt-tracker-prod --remote",
    "wrangler:migrate:reconcile": "node docker/reconcile.mjs hrt-tracker-prod --remote",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri": "tauri",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "openpgp": "^6.3.2",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^1.6.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.147.0"
  }
}
