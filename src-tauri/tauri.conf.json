{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Oyama's HRT Tracker",
    "version": "1.6.0-rc.5"
  },
  "build": {
    "beforeDevCommand": "npm run dev -- --host",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "Oyama's HRT Tracker",
        "width": 1000,
        "height": 800,
        "minWidth": 420,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.smirnovayama.hrttracker",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": [
        "dmg",
        "app",
        "msi"
      ],
      "macOS": {
        "signingIdentity": "-"
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://hrt.mahiro.uk; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self';"
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "updater": {
      "active": false
    }
  }
}
