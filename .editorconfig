root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# These files still use 2-space indents. Remove this section in the
# repo-wide Prettier reformat, which moves them to 4.
[/{worker.ts,vite.config.ts,vitest.config.ts}]
indent_size = 2
